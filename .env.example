# ===========================================
# Unified Cloud Kitchen Platform - Environment
# ===========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# -------------------------------------------
# Backend
# -------------------------------------------
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cloud_kitchen
DATABASE_URL_SYNC=postgresql://user:password@localhost:5432/cloud_kitchen
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------------------------
# Email
# -------------------------------------------
# Set EMAIL_PROVIDER to 'smtp', 'sendgrid', or 'console' (for dev)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@cloudkitchen.example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDGRID_API_KEY=

# -------------------------------------------
# Frontend
# -------------------------------------------
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:8000

# -------------------------------------------
# CORS
# -------------------------------------------
CORS_ORIGINS=http://localhost:3000

# -------------------------------------------
# App
# -------------------------------------------
APP_NAME=Unified Cloud Kitchen Platform
APP_ENV=development
DEBUG=true
