# Unified Cloud Kitchen Platform - Environment Variables Template
# Copy this file to .env and replace placeholders with actual values.
# NEVER commit the real .env file with secrets to version control.

# Application Configuration
APP_NAME="Unified Cloud Kitchen Platform"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Security & Sessions
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-at-least-32-chars
SESSION_COOKIE_NAME=cloudkitchen_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE_SECONDS=86400

# Database Configuration (PostgreSQL)

POSTGRES_USER=your_postgres_username
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_database_name
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=your_database_connection_url
# Test database URL (defaults to in-memory/file SQLite or dedicated PostgreSQL test db)
TEST_DATABASE_URL=sqlite+aiosqlite:///./test.db

# Machine Learning & Demand Forecasting
DATA_DIR=./data
ML_MODELS_DIR=./ml/artifacts

# AI / Gemini API Integration (Optional for natural language food search & analytics summaries)
GEMINI_API_KEY=your_gemini_api_key

PAYMENT_GATEWAY_MODE=unconfigured
PAYMENT_API_KEY=your_payment_api_key
PAYMENT_API_SECRET=your_payment_api_secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
SMTP_FROM_EMAIL=noreply@kitchenverse.com
SMTP_FROM_NAME="KitchenVerse Support"

VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
