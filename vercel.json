{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://kitchenverse.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://kitchenverse.onrender.com/health"
    },
    {
      "source": "/docs",
      "destination": "https://kitchenverse.onrender.com/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://kitchenverse.onrender.com/openapi.json"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://kitchenverse.onrender.com/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
