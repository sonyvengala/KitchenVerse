# Backend Environment Configuration
# Copy this to backend/.env and fill in real values

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cloud_kitchen
DATABASE_URL_SYNC=postgresql://user:password@localhost:5432/cloud_kitchen
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@cloudkitchen.example.com
SECRET_KEY=replace_with_a_random_secret_key
APP_ENV=development
DEBUG=True
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDGRID_API_KEY=
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
APP_NAME=Unified Cloud Kitchen Platform
APP_ENV=development
DEBUG=true
